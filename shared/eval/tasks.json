{
  "about": "Planted-bug tasks on the test repository (shared/fixtures/cpp-sample). Each task has the question a developer asks, the StaticSight calls that answer it, the evidence a correct answer must contain (file, line within +/-3, one of the keywords), and the files an assistant without StaticSight would have to read.",
  "tasks": [
    {"id": "leak_early_return", "question": "Review the changes on this branch against origin/main. Does any changed function leak memory?",
     "calls": [["review_changes", {}]],
     "expect": {"file": "src/router.cpp", "line": 13, "any": ["leak", "not released", "memleak"]},
     "read": ["src/router.cpp", "src/router.hpp"]},
    {"id": "leak_project_allocator", "question": "Review encode_batch in src/net/proto.cpp. Is every buffer from mem::zero_copy_allocate released?",
     "calls": [["run_file_static_audit", {"file_path": "src/net/proto.cpp"}]],
     "expect": {"file": "src/net/proto.cpp", "line": 43, "any": ["leak", "not released", "ring"]},
     "read": ["src/net/proto.cpp", "src/memory/pool.hpp"]},
    {"id": "lock_order_cycle", "question": "Can ConnPool deadlock? Name the two code paths.",
     "calls": [["track_lock_order", {}]],
     "expect": {"file": "src/net/conn_pool.cpp", "line": 31, "any": ["deadlock", "cycle", "opposite"]},
     "read": ["src/net/conn_pool.cpp"]},
    {"id": "lock_across_send", "question": "Is any lock in ConnPool held across a blocking call?",
     "calls": [["track_lock_order", {"symbol": "stats_mutex"}]],
     "expect": {"file": "src/net/conn_pool.cpp", "line": 34, "any": ["send", "blocking"]},
     "read": ["src/net/conn_pool.cpp"]},
    {"id": "switch_gap", "question": "MsgType gained a Ping value. Is every switch over MsgType updated?",
     "calls": [["find_switch_coverage", {"enum_name": "MsgType"}]],
     "expect": {"file": "src/net/proto.cpp", "line": 31, "any": ["Ping", "missing"]},
     "read": ["src/net/proto.hpp", "src/net/proto.cpp"]},
    {"id": "platform_twin", "question": "start_timer was changed for POSIX. Is the change complete?",
     "calls": [["find_counterparts", {"symbol": "start_timer"}]],
     "expect": {"file": "src/platform/timer_win.cpp", "line": 3, "any": ["not changed", "counterpart", "twin", "windows"]},
     "read": ["src/platform/timer_posix.cpp", "src/platform/timer_win.cpp"]},
    {"id": "unlocked_write", "question": "Is route_count thread-safe?",
     "calls": [["track_state_mutations", {"symbol": "route_count"}]],
     "expect": {"file": "src/router.cpp", "line": 38, "any": ["lock", "race", "bare"]},
     "read": ["src/router.cpp", "src/router.hpp"]},
    {"id": "struct_layout", "question": "Packet gained a checksum field. Which code depends on its byte layout?",
     "calls": [["track_struct_risks", {"struct_name": "Packet"}]],
     "expect": {"file": "src/net/socket.cpp", "line": 6, "any": ["send", "sizeof", "layout"]},
     "read": ["src/net/packet.hpp", "src/net/socket.cpp", "src/storage/wal.cpp", "src/net/listener.cpp"]},
    {"id": "ignored_result", "question": "process_packet can now return -2. Which callers ignore its result?",
     "calls": [["get_impact", {"symbol": "process_packet"}]],
     "expect": {"file": "src/net/listener.cpp", "line": 17, "any": ["ignored", "ignore"]},
     "read": ["src/router.cpp", "src/net/listener.cpp", "src/net/server_loop.cpp", "tests/test_router.cpp", "src/main.cpp"]},
    {"id": "entry_exposure", "question": "Can a worker thread reach Router::process_packet, and through which call chain?",
     "calls": [["find_entry_paths", {"symbol": "process_packet"}]],
     "expect": {"file": "src/net/server_loop.cpp", "line": 9, "any": ["thread", "pump_loop"]},
     "read": ["src/main.cpp", "src/net/server_loop.cpp", "src/router.cpp"]},
    {"id": "log_origin", "question": "A log says: decode_msg: unknown message type 'Q' from peer 1.2.3.4. Which code printed it?",
     "calls": [["find_log_origin", {"text": "decode_msg: unknown message type 'Q' from peer 1.2.3.4"}]],
     "expect": {"file": "src/net/proto.cpp", "line": 26, "any": ["decode_msg", "log_error"]},
     "read": ["src/net/proto.cpp", "src/log.hpp"]},
    {"id": "virtual_override", "question": "I want to change Transport::send_frame. Which implementations must change too?",
     "calls": [["get_type_hierarchy", {"type_name": "Transport"}]],
     "expect": {"file": "src/net/transport.hpp", "line": 20, "any": ["TlsTransport", "override"]},
     "read": ["src/net/transport.hpp", "src/net/transport.cpp"]}
  ]
}
